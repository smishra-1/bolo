# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: server only. Used just for the shared lesson cache.
SUPABASE_SECRET_KEY=

# Vercel AI Gateway: lessons, chat, translation and Whisper speech-to-text.
# Create a key: Vercel dashboard → AI Gateway → API Keys (or `vercel ai-gateway api-keys create`).
# On Vercel deployments you can leave this empty: the project's OIDC token is used instead.
AI_GATEWAY_API_KEY=
# Optional overrides. IDs must exist in https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
AI_GATEWAY_TRANSCRIBE_MODEL=openai/whisper-1
# Max AI calls per learner per day
AI_DAILY_LIMIT=200
